// 会议记录。音频走平台媒体对象存储，不占用户云盘配额，也不出现在云盘列表、
// 搜索和同步里；这里只存元数据与逐字稿。
model Meeting {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String   @db.VarChar(255)
  startedAt            DateTime
  durationMs           Int      @default(0)
  status               String   @default("transcribing") @db.VarChar(32)
  speakerCount         Int      @default(0)
  failureReason        String?  @db.VarChar(1000)
  minutesStatus        String   @default("none") @db.VarChar(32)
  minutesJson          Json?
  minutesFailureReason String?  @db.VarChar(1000)
  minutesEditedAt      DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  recording            MeetingRecording?
  transcriptionJob     MeetingTranscriptionJob?
  segments             MeetingTranscriptSegment[]
  speakers             MeetingSpeaker[]

  @@index([userId, startedAt])
  @@index([status, updatedAt])
  @@index([userId, status, createdAt])
}

// 形状对齐 DocumentHostedImage：对象路径、内容类型、字节数、删除态。
// `peaks` 是整段回放波形的振幅（每 100 毫秒一个字节，base64），录音仍在时不为空。
model MeetingRecording {
  id            String    @id @default(cuid())
  meetingId     String    @unique
  meeting       Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  storageKey    String    @unique
  mimeType      String    @default("audio/mp4") @db.VarChar(128)
  size          BigInt    @default(0)
  durationMs    Int       @default(0)
  peaks         String?
  status        String    @default("pending") @db.VarChar(32)
  deletedAt     DateTime?
  deletePending Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([deletePending, updatedAt])
}

// 转写任务单独建表而不把状态塞进 Meeting：重试、分片续传和失败排查都要有地方落。
// `taskId` 不能当业务唯一键——腾讯云明确不同日期可能重复 TaskId。
model MeetingTranscriptionJob {
  id              String          @id @default(cuid())
  meetingId       String          @unique
  meeting         Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  storageKey      String
  engineModelType String          @default("16k_zh_en_meeting") @db.VarChar(64)
  parameters      Json?
  taskId          String?         @db.VarChar(64)
  status          String          @default("pending") @db.VarChar(32)
  uploadId        String?
  totalBytes      BigInt          @default(0)
  attempts        Int             @default(0)
  lastError       String?         @db.VarChar(1000)
  submittedAt     DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  parts           MeetingUploadPart[]

  @@index([status, updatedAt])
  @@index([status, expiresAt])
}

// 分片清单用独立表而不是 Json 列：中止时要按 partNumber 精确核对，续传时要跳过
// 已确认写入的区间。
model MeetingUploadPart {
  id         String                  @id @default(cuid())
  jobId      String
  job        MeetingTranscriptionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partNumber Int
  etag       String                  @db.VarChar(128)
  size       Int
  createdAt  DateTime                @default(now())

  @@unique([jobId, partNumber])
  @@index([jobId])
}

model MeetingTranscriptSegment {
  id           String   @id @default(cuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  segmentIndex Int
  speakerId    Int      @default(0)
  startMs      Int
  endMs        Int
  text         String
  words        Json?
  createdAt    DateTime @default(now())

  @@unique([meetingId, segmentIndex])
  @@index([meetingId, startMs])
}

// 说话人编号到真名的映射。腾讯云只给「发言人 1/2/3」，用户填一次名字全篇套用。
model MeetingSpeaker {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speakerId Int
  name      String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, speakerId])
}

// 管理员维护团队成员关系；Skill Hub 条目归团队所有。
model Team {
  id        String           @id @default(cuid())
  name      String           @unique @db.VarChar(30)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  members   TeamMembership[]
  organizations Organization[]
  skillHubSkills SkillHubSkill[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  organizations OrganizationMembership[]

  @@unique([teamId, userId])
  @@index([userId])
}

model Organization {
  id        String @id @default(cuid())
  teamId    String
  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Organization? @relation("OrganizationTree", fields: [parentId, teamId], references: [id, teamId], onDelete: Cascade, onUpdate: NoAction)
  children  Organization[] @relation("OrganizationTree")
  name      String @db.VarChar(30)
  members   OrganizationMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, name])
  @@unique([id, teamId])
  @@index([parentId, teamId])
}

model OrganizationMembership {
  organizationId String
  teamId String
  userId String
  organization Organization @relation(fields: [organizationId, teamId], references: [id, teamId], onDelete: Cascade)
  teamMembership TeamMembership @relation(fields: [teamId, userId], references: [teamId, userId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([organizationId, userId])
  @@index([teamId, userId])
}

model MailMessage {
  id              String          @id @default(cuid())
  senderId        String?
  sender          User?           @relation("MailSender", fields: [senderId], references: [id], onDelete: Restrict)
  kind            String          @default("user") @db.VarChar(24)
  teamIdSnapshot  String?
  teamNameSnapshot String?        @db.VarChar(30)
  broadcastRequestId String?      @unique @db.VarChar(100)
  subject         String          @db.VarChar(120)
  body            String          @db.Text
  conversationId  String          @db.VarChar(100)
  replyToId       String?
  forwardOfId     String?
  quoteSnapshot   Json?
  addressSnapshot Json?
  clientRequestId String          @db.VarChar(100)
  previewId       String          @unique
  senderDeletedAt DateTime?
  sentAt          DateTime        @default(now())
  recipients      MailRecipient[]
  attachments     MailAttachment[]
  notificationOutbox MailNotificationOutbox[]

  @@unique([senderId, clientRequestId])
  @@index([senderId, senderDeletedAt, sentAt, id])
  @@index([teamIdSnapshot, sentAt])
  @@index([sentAt, id])
  @@index([conversationId, sentAt, id])
}

model MailRecipient {
  id        String       @id @default(cuid())
  deliverySequence BigInt @unique @default(autoincrement())
  messageId String
  message   MailMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      String       @default("to") @db.VarChar(2)
  readAt    DateTime?
  deletedAt DateTime?

  @@unique([messageId, userId])
  @@index([userId, deletedAt, messageId])
  @@index([userId, deletedAt, deliverySequence])
}

model MailNotificationOutbox {
  id          String      @id @default(cuid())
  messageId   String
  message     MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientId String
  createdAt   DateTime    @default(now())

  @@unique([messageId, recipientId])
  @@index([createdAt])
}

model MailSendPreview {
  id             String   @id @default(cuid())
  formatVersion  Int      @default(1)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientIds   Json
  ccIds          Json     @default("[]")
  toOrganizationIds Json @default("[]")
  ccOrganizationIds Json @default("[]")
  attachmentIds  Json
  teamIdSnapshot String
  teamNameSnapshot String @db.VarChar(30)
  subject        String   @db.VarChar(120)
  body           String   @db.Text
  replyToId      String?
  forwardOfId    String?
  conversationId String   @db.VarChar(100)
  quoteSnapshot  Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId, expiresAt])
}

model MailAttachment {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  messageId   String?
  message     MailMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String       @db.VarChar(255)
  mimeType    String?      @db.VarChar(255)
  size        BigInt
  storageKey  String       @unique
  sourceItemId String?
  sourceVersionId String?
  createdAt   DateTime     @default(now())
  lastReferencedAt DateTime @default(now())

  @@index([ownerId, messageId, createdAt])
  @@index([messageId, lastReferencedAt, id])
}

model MailStorageDeletion {
  id         String   @id @default(cuid())
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([createdAt])
}


enum TodoReminderKind {
  none
  at_due
  before_due
  custom
}

enum TodoReminderStatus {
  none
  pending
  sent
  cancelled
  expired
}

enum TodoPriority {
  high
  medium
  low
}

model TodoItem {
  id                 String @id @default(cuid())
  userId             String
  deliveries         TodoReminderDelivery[]
  images             TodoImage[]
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  note               String?
  priority           TodoPriority?
  dueAt              DateTime?
  reminder           TodoReminderKind @default(none)
  offsetMinutes      Int?
  remindAt           DateTime?
  reminderGeneration Int @default(1)
  reminderStatus     TodoReminderStatus @default(none)
  completedAt        DateTime?
  version            Int @default(1)
  createRequestId    String
  createRequestHash  String
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, createRequestId])
  @@index([userId, deletedAt, completedAt, dueAt, createdAt, id])
  @@index([reminderStatus, remindAt])
  @@index([deletedAt])
}

model TodoImage {
  id            String @id @db.Uuid
  userId        String
  todoId        String?
  todo          TodoItem? @relation(fields: [todoId], references: [id], onDelete: SetNull)
  position      Int @default(0)
  mimeType      String
  byteSize      Int
  thumbnailSize Int
  sha256        String
  ready         Boolean @default(false)
  expiresAt     DateTime?

  @@index([userId, todoId])
  @@index([todoId, expiresAt])
}

enum TodoDeliveryStatus {
  pending
  delivered
  skipped
  expired
}

model TodoReminderDelivery {
  id             String @id @default(cuid())
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  todoId         String
  todo           TodoItem @relation(fields: [todoId], references: [id], onDelete: Cascade)
  generation     Int
  notificationId String @unique
  notification   UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  remindAt       DateTime
  status         TodoDeliveryStatus @default(pending)
  attempts       Int @default(0)
  nextAttemptAt  DateTime
  leaseUntil     DateTime?
  leaseToken     String?
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([todoId, generation])
  @@index([status, nextAttemptAt, leaseUntil])
  @@index([createdAt])
}

model TodoMutationReceipt {
  id              String @id @default(cuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientRequestId String
  requestHash     String
  response        Json
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([userId, clientRequestId])
  @@index([expiresAt])
}

model DriveDiscussionNotificationTarget {
  id String @id @default(cuid())
  notificationId String @unique
  notification UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  itemId String
  kind String @db.VarChar(16)
  action String @db.VarChar(16)
  threadId String?
  messageId String?
  commentId String?
  sourceShareId String?
  snapshot Json?
  createdAt DateTime @default(now())
}
model DriveDiscussionNotificationDelivery {
  id String @id @default(cuid())
  notificationId String @unique
  notification UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId String
  status String @default("pending") @db.VarChar(16)
  attempts Int @default(0)
  nextAttemptAt DateTime
  leaseUntil DateTime?
  leaseToken String?
  failureReason String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt, leaseUntil], map: "DriveDiscussionNotificationDelivery_claim_idx")
  @@index([createdAt], map: "DriveDiscussionNotificationDelivery_createdAt_idx")
}

model NotificationImage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectKey    String   @unique @db.VarChar(200)
  mimeType     String   @db.VarChar(64)
  byteSize     Int
  state        String   @db.VarChar(20)
  createdAt    DateTime @default(now())
  expiresAt    DateTime?
  notification UserNotification?

  @@index([userId])
  @@index([state, expiresAt])
}

enum SkillHubUploadPurpose {
  package
  icon
}

enum SkillHubUploadState {
  staging
  ready
  bound
  cleanup
}

enum SkillHubObjectKind {
  archive
  main
  icon
}

enum SkillHubObjectState {
  staging
  ready
  deletePending
}

model SkillHubSkill {
  id                   String   @id @default(cuid())
  teamId               String
  team                 Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdById          String?
  createdBy            User?    @relation("SkillHubCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName        String
  maintainerUserId     String?
  maintainer           User?    @relation("SkillHubMaintainer", fields: [maintainerUserId], references: [id], onDelete: SetNull)
  maintainerName       String
  displayName          String
  displayDescription   String
  iconObjectId         String?
  iconObject           SkillHubObject? @relation("SkillHubIcon", fields: [iconObjectId], references: [id], onDelete: Restrict)
  currentVersionId     String?
  currentVersion       SkillHubVersion? @relation("SkillHubCurrentVersion", fields: [id, currentVersionId], references: [skillId, id], onDelete: NoAction, onUpdate: NoAction)
  versions             SkillHubVersion[] @relation("SkillHubVersions")
  writeReceipts        SkillHubWriteReceipt[]
  revision             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  publishedAt          DateTime @default(now())
  deletedAt            DateTime?
  deletedById          String?
  deletedBy            User?    @relation("SkillHubDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([teamId, deletedAt, publishedAt, id])
  @@index([createdById])
  @@index([maintainerUserId])
  @@index([deletedById])
  @@index([iconObjectId])
}

model SkillHubVersion {
  id                   String   @id @default(cuid())
  skillId              String
  skill                SkillHubSkill @relation("SkillHubVersions", fields: [skillId], references: [id], onDelete: Restrict)
  currentFor           SkillHubSkill[] @relation("SkillHubCurrentVersion")
  writeReceipts        SkillHubWriteReceipt[]
  number               Int
  packageName          String
  packageDescription   String
  manifest             Json
  contentFingerprint   String
  archiveObjectId      String
  archiveObject        SkillHubObject @relation("SkillHubArchive", fields: [archiveObjectId], references: [id], onDelete: Restrict)
  mainObjectId         String
  mainObject           SkillHubObject @relation("SkillHubMain", fields: [mainObjectId], references: [id], onDelete: Restrict)
  createdAt            DateTime @default(now())

  @@unique([skillId, id])
  @@unique([skillId, number])
  @@index([archiveObjectId])
  @@index([mainObjectId])
}

// Uploads are scoped to immutable caller/team IDs. Unbound staging must remain
// reclaimable even if that user or an otherwise empty team is deleted.
model SkillHubUpload {
  id                   String   @id @default(cuid())
  actorKey             String
  teamId               String
  requestId            String
  purpose              SkillHubUploadPurpose
  state                SkillHubUploadState @default(staging)
  expiresAt            DateTime
  inputSha256          String
  packageName          String?
  packageDescription   String?
  manifest             Json?
  contentFingerprint   String?
  objects              SkillHubObject[]
  createdAt            DateTime @default(now())

  @@unique([actorKey, teamId, purpose, requestId])
  @@index([state, expiresAt, id])
}

model SkillHubObject {
  id                   String   @id @default(cuid())
  uploadId             String
  upload               SkillHubUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  storageKey           String   @unique
  kind                 SkillHubObjectKind
  state                SkillHubObjectState @default(staging)
  size                 Int
  sha256               String
  nextCleanupAt        DateTime?
  cleanupAttempts      Int      @default(0)
  archiveVersions      SkillHubVersion[] @relation("SkillHubArchive")
  mainVersions         SkillHubVersion[] @relation("SkillHubMain")
  iconSkills           SkillHubSkill[] @relation("SkillHubIcon")
  createdAt            DateTime @default(now())

  @@unique([uploadId, kind])
  @@index([state, nextCleanupAt, id])
}

model SkillHubWriteReceipt {
  id                   String   @id @default(cuid())
  actorKey             String
  action               String
  requestId            String
  requestDigest        String
  skillId              String
  skill                SkillHubSkill @relation(fields: [skillId], references: [id], onDelete: Restrict)
  versionId            String?
  version              SkillHubVersion? @relation(fields: [skillId, versionId], references: [skillId, id], onDelete: Restrict)
  result               Json
  createdAt            DateTime @default(now())

  @@unique([actorKey, action, requestId])
  @@index([skillId, versionId])
}
