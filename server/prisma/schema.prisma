generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminStatus {
  active
  disabled
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  status       AdminStatus @default(active)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  targetType String
  targetId   String
  detail     Json?
  ipAddress  String
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}
