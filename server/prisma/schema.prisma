generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum UserAvatarSource {
  system
  custom
}

enum AuditActorType {
  user
  platform_admin
  system
  unknown
}

model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  ipAddress  String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@index([revokedAt])
}

model User {
  id                             String                          @id @default(cuid())
  email                          String                          @unique
  handle                         String                          @unique @db.VarChar(64)
  /// 用户自填的展示昵称，只在控制台个人资料和桌面端账号区显示。
  /// 不参与公开身份与 URL（那部分是 handle），允许重复，注册时默认取 handle。
  nickname                       String                          @db.VarChar(24)
  /// 用户自填的联系邮箱，同团队活跃成员可查询；不用于认证，默认空。
  contactEmail                   String?                         @db.VarChar(320)
  avatarUrl                      String?                         @db.VarChar(512)
  avatarSource                   UserAvatarSource?
  systemAvatarId                 String?                         @db.VarChar(128)
  systemAvatar                   SystemAvatar?                   @relation("SelectedSystemAvatar", fields: [systemAvatarId], references: [id], onDelete: Restrict)
  customAvatarAssetId            String?                         @unique
  customAvatarAsset              UserAvatarAsset?                @relation("SelectedCustomAvatar", fields: [customAvatarAssetId], references: [id], onDelete: SetNull)
  avatarAssets                   UserAvatarAsset[]               @relation("UserAvatarAssets")
  customApps                     UserCustomApp[]
  customAppTombstones           UserCustomAppTombstone[]
  customAppIconAssets            UserCustomAppIconAsset[]
  customAppSettings              UserCustomAppSettings?
  customAppOperations            UserCustomAppOperation[]
  adminNote                      String?                         @db.VarChar(500)
  passwordHash                   String
  passwordChangedAt              DateTime?
  status                         UserStatus                      @default(active)
  sessions                       UserSession[]
  desktopLoginCodes              DesktopLoginCode[]
  passwordResetTokens            UserPasswordResetToken[]
  modulePermissions              UserModulePermission[]
  webhooks                       UserWebhook[]
  apiKeys                        UserApiKey[]
  notifications                  UserNotification[]
  notificationImages             NotificationImage[]
  todoItems                      TodoItem[]
  todoMutationReceipts            TodoMutationReceipt[]
  todoReminderDeliveries          TodoReminderDelivery[]
  openApiDownloadGrants          OpenApiDownloadGrant[]
  openApiUsageLogs               OpenApiUsageLog[]
  devices                        UserDevice[]
  driveBrowsingHistory           DriveBrowsingHistory[]
  driveItems                     DriveItem[]
  driveUsage                     DriveUsage?
  driveUploadSessions            DriveUploadSession[]
  documentImageUploads           DocumentImageUploadSession[]  @relation("DocumentImageUploadActor")
  uploadedDocumentImages         DocumentHostedImage[]          @relation("DocumentImageUploader")
  driveFileVersions              DriveFileVersion[]
  driveFileVersionContributions  DriveFileVersionContributor[]
  driveChanges                   DriveChange[]
  driveAnnotationThreads         DriveAnnotationThread[]
  driveAnnotationComments        DriveAnnotationComment[]
  driveMessages                  DriveMessage[]
  driveMessageComments           DriveMessageComment[]
  publicAssets                   PublicAsset[]
  driveSites                     DriveSite[]
  userHandleRedirects            UserHandleRedirect[]
  agentPersonas                  AgentPersona[]
  agentPersonaPreferences        AgentPersonaPreference[]
  clientTelemetryEvents          ClientTelemetryEvent[]
  meetings                       Meeting[]
  teamMemberships                TeamMembership[]
  skillHubContributions          SkillHubSkill[]                  @relation("SkillHubCreator")
  skillHubMaintained             SkillHubSkill[]                  @relation("SkillHubMaintainer")
  skillHubDeletions              SkillHubSkill[]                  @relation("SkillHubDeleter")
  organizationMemberships        OrganizationMembership[]
  mailMessagesSent               MailMessage[]                   @relation("MailSender")
  mailRecipients                 MailRecipient[]
  mailPreviews                    MailSendPreview[]
  mailAttachments                 MailAttachment[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
}

model SystemAvatar {
  id            String   @id @db.VarChar(128)
  storageKey    String   @unique @db.VarChar(255)
  publicUrl     String   @unique @db.VarChar(512)
  mimeType      String   @default("image/webp") @db.VarChar(64)
  sortOrder     Int      @unique
  selectedBy    User[]   @relation("SelectedSystemAvatar")
  createdAt     DateTime @default(now())
}

/// Custom avatar bytes live in Platform Media COS. Status transitions are persisted
/// before object deletion so a transient COS failure remains retryable.
model UserAvatarAsset {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserAvatarAssets", fields: [userId], references: [id], onDelete: Cascade)
  storageKey    String   @unique @db.VarChar(255)
  publicUrl     String   @unique @db.VarChar(512)
  mimeType      String   @db.VarChar(64)
  byteSize      Int
  status        String   @db.VarChar(24)
  deletePending Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  currentFor    User?    @relation("SelectedCustomAvatar")

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([deletePending, updatedAt])
}

model UserCustomApp {
  id             String                   @id @db.VarChar(64)
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String                   @default("web") @db.VarChar(32)
  name           String                   @db.VarChar(64)
  startUrl       String                   @db.VarChar(2048)
  openMode       String                   @default("window") @db.VarChar(16)
  iconId         String?                  @unique @db.VarChar(64)
  icon           UserCustomAppIconAsset?  @relation("UserCustomAppCurrentIcon", fields: [iconId], references: [id], onDelete: SetNull)
  iconSource     String                   @default("favicon") @db.VarChar(16)
  version        Int                      @default(1)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  iconAssets     UserCustomAppIconAsset[] @relation("UserCustomAppIconAssets")

  @@index([userId, createdAt, id])
  @@index([kind, userId])
}

model UserCustomAppTombstone {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId     String   @db.VarChar(64)
  deletedAt DateTime @default(now())

  @@id([userId, appId])
  @@index([deletedAt])
}

model UserCustomAppIconAsset {
  id            String         @id @db.VarChar(64)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId         String?        @db.VarChar(64)
  app           UserCustomApp? @relation("UserCustomAppIconAssets", fields: [appId], references: [id], onDelete: SetNull)
  storageKey    String         @unique @db.VarChar(255)
  mimeType      String         @default("image/png") @db.VarChar(64)
  byteSize      Int
  status        String         @db.VarChar(24)
  deletePending Boolean        @default(false)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  currentFor    UserCustomApp? @relation("UserCustomAppCurrentIcon")

  @@index([userId, status, createdAt])
  @@index([appId, createdAt])
  @@index([deletePending, updatedAt])
}

model UserCustomAppSettings {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dockAppIds         Json      @default("[]")
  dockMigrationIds   Json      @default("[]")
  dockCatalogVersion Int       @default(1)
  revision           Int       @default(0)
  initializedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model UserCustomAppOperation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationId    String   @db.VarChar(200)
  operationHash  String   @db.VarChar(64)
  resultRevision Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([userId, operationId])
  @@index([expiresAt])
}

model UserNotification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      String    @db.VarChar(32)
  sourceKey   String?   @db.VarChar(200)
  title       String    @db.VarChar(64)
  body        String    @db.VarChar(512)
  group       String?   @db.VarChar(64)
  url         String?   @db.VarChar(2048)
  copyOnTap   Boolean   @default(false)
  level       String    @db.VarChar(20)
  targetId    String?   @db.VarChar(120)
  deviceId    String?   @db.VarChar(120)
  readAt      DateTime?
  resolvedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  imageId     String?   @unique @db.VarChar(64)
  image       NotificationImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  todoDelivery TodoReminderDelivery?
  driveDiscussionTarget DriveDiscussionNotificationTarget?
  driveDiscussionDelivery DriveDiscussionNotificationDelivery?

  @@unique([userId, sourceKey])
  @@index([userId, deletedAt, createdAt, id])
  @@index([userId, readAt, deletedAt])
  @@index([userId, source, deviceId, targetId, resolvedAt])
  @@index([createdAt])
}

model ClientTelemetryEvent {
  eventId          String   @id @db.VarChar(64)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String   @db.VarChar(24)
  eventKey         String   @db.VarChar(64)
  component        String   @db.VarChar(64)
  action           String   @db.VarChar(32)
  outcome          String?  @db.VarChar(16)
  durationMs       Int?
  moduleId         String?  @db.VarChar(64)
  windowType       String   @db.VarChar(32)
  clientInstanceId String   @db.VarChar(64)
  sessionId        String   @db.VarChar(64)
  appVersion       String   @db.VarChar(32)
  platform         String   @db.VarChar(32)
  browserName      String?  @db.VarChar(64)
  browserVersion   String?  @db.VarChar(32)
  osName           String?  @db.VarChar(64)
  osVersion        String?  @db.VarChar(32)
  occurredAt       DateTime
  receivedAt       DateTime @default(now())

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([clientInstanceId, occurredAt])
  @@index([category, eventKey, occurredAt])
  @@index([eventKey, occurredAt])
  @@index([moduleId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([appVersion, occurredAt])
  @@index([platform, occurredAt])
  @@index([browserName, browserVersion, occurredAt])
  @@index([osName, osVersion, occurredAt])
}

model UserApiKey {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String                 @db.VarChar(80)
  keyHash               String                 @unique @db.VarChar(64)
  keyPrefix             String                 @db.VarChar(24)
  scopes                String[]               @default([])
  tableAccessMode       String                 @default("selected") @db.VarChar(16)
  tableIds              String[]               @default([])
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime               @default(now())
  openApiDownloadGrants OpenApiDownloadGrant[]
  openApiUsageLogs      OpenApiUsageLog[]

  @@index([userId, revokedAt, createdAt])
}

model CloudTable {
  id            String   @id @default(cuid())
  ownerId       String
  name          String   @db.VarChar(100)
  schemaVersion Int      @default(1)
  anonymous     Json     @default("{}")
  members       Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  fields        CloudTableField[]
  records       CloudTableRecord[]
  receipts      CloudTableReceipt[]
  stats         CloudTableStats?

  @@index([ownerId, deletedAt, id])
  @@index([members], type: Gin)
  @@index([deletedAt])
}

// 触发器与记录写入同事务维护；目录只读取统计，不扫描记录。
model CloudTableStats {
  tableId     String @id
  table       CloudTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  recordCount BigInt @default(0)
}

model CloudTableField {
  id         String @id @default(cuid())
  tableId    String
  table      CloudTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  key        String @db.VarChar(64)
  definition Json
  position   Int
  archivedAt DateTime?
  @@unique([tableId, key])
  @@index([tableId, archivedAt, position])
  @@index([archivedAt])
}

model CloudTableRecord {
  id            String @id @default(cuid())
  tableId       String
  table         CloudTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  values        Json
  creatorUserId String?
  version       Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  @@index([tableId, deletedAt, createdAt, id])
  @@index([tableId, id])
  @@index([tableId, creatorUserId, deletedAt, createdAt, id])
  @@index([deletedAt, id])
  @@index([values], type: Gin)
}

model CloudTableReceipt {
  id          String @id @default(cuid())
  tableId     String
  table       CloudTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  namespace   String @db.VarChar(200)
  key         String @db.VarChar(120)
  fingerprint String @db.VarChar(64)
  result      Json
  createdAt   DateTime @default(now())
  @@unique([namespace, key])
  @@index([tableId])
  @@index([createdAt])
}

model CloudTableOperationLog {
  id         String @id @default(cuid())
  ownerId    String
  tableId    String?
  actorId    String?
  apiKeyId   String?
  requestId  String @unique @db.VarChar(64)
  operation  String @db.VarChar(64)
  status     Int
  durationMs Int
  createdAt  DateTime @default(now())
  @@index([ownerId, tableId, id])
  @@index([createdAt])
}

model OpenApiDownloadGrant {
  id           String                      @id @default(cuid())
  tokenHash    String                      @unique @db.VarChar(64)
  apiKeyId     String
  apiKey       UserApiKey                  @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  userId       String
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType   String                      @db.VarChar(32)
  artifactType String                      @db.VarChar(16)
  planVersion  Int                         @default(1)
  snapshotId   String                      @db.VarChar(64)
  fileName     String                      @db.VarChar(255)
  mimeType     String                      @db.VarChar(255)
  size         BigInt?
  entryPath    String?                     @db.VarChar(1024)
  target       Json
  expiresAt    DateTime
  leaseUntil   DateTime
  createdAt    DateTime                    @default(now())
  entries      OpenApiDownloadGrantEntry[]

  @@index([apiKeyId, expiresAt])
  @@index([expiresAt])
  @@index([leaseUntil])
}

model OpenApiDownloadGrantEntry {
  id                 String               @id @default(cuid())
  grantId            String
  grant              OpenApiDownloadGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  ordinal            Int
  entryType          String               @db.VarChar(16)
  relativePath       String?              @db.VarChar(1024)
  storageKey         String?
  driveFileVersionId String?
  driveFileVersion   DriveFileVersion?    @relation(fields: [driveFileVersionId], references: [id], onDelete: Restrict)
  size               BigInt?
  mimeType           String?              @db.VarChar(255)
  etag               String?
  sha256             String?              @db.VarChar(64)

  @@unique([grantId, ordinal])
  @@index([driveFileVersionId, grantId])
}

model OpenApiUsageLog {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId      String
  apiKey        UserApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  grantId       String?
  requestId     String     @unique @db.VarChar(64)
  operation     String     @db.VarChar(32)
  scope         String     @db.VarChar(120)
  status        String     @db.VarChar(16)
  httpStatus    Int?
  errorCode     String?    @db.VarChar(64)
  sourceType    String?    @db.VarChar(32)
  artifactType  String?    @db.VarChar(16)
  durationMs    Int?
  responseBytes BigInt?
  ipAddress     String     @db.VarChar(64)
  startedAt     DateTime   @default(now())
  completedAt   DateTime?

  @@index([apiKeyId, startedAt])
  @@index([userId, startedAt])
  @@index([startedAt])
}

model AgentPersona {
  id                   String                   @id @default(cuid())
  source               String                   @db.VarChar(16)
  ownerUserId          String?
  owner                User?                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  stableKey            String?                  @db.VarChar(120)
  name                 String                   @db.VarChar(120)
  description          String                   @db.VarChar(1000)
  systemPrompt         String
  defaultProviderModel Json?
  defaultToolPolicy    Json?
  status               String                   @db.VarChar(16)
  version              Int                      @default(1)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  preferences          AgentPersonaPreference[]

  @@unique([source, stableKey])
  @@index([ownerUserId, source, updatedAt])
  @@index([source, status, updatedAt])
}

model AgentPersonaPreference {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaId     String
  persona       AgentPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  providerModel Json?
  toolPolicy    Json?
  updatedAt     DateTime     @updatedAt

  @@unique([userId, personaId])
  @@index([userId, updatedAt])
}

model UserModulePermission {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  grantedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, permissionKey])
  @@index([permissionKey])
}

model UserSession {
  id               String                    @id @default(cuid())
  userId           String
  user             User                      @relation(fields: [userId], references: [id])
  sourceSessionId  String?
  refreshTokenHash String                    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime                  @default(now())
  refreshTokens    UserSessionRefreshToken[]

  @@index([userId])
  @@index([sourceSessionId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model UserSessionRefreshToken {
  id               String      @id @default(cuid())
  sessionId        String
  session          UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  refreshTokenHash String      @unique
  expiresAt        DateTime
  replacedAt       DateTime?
  graceExpiresAt   DateTime?
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())

  @@index([sessionId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([graceExpiresAt])
}

model UserDevice {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientInstanceId String
  displayName      String?  @db.VarChar(120)
  deviceName       String   @db.VarChar(120)
  platform         String   @db.VarChar(80)
  appVersion       String   @db.VarChar(80)
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// Notification target for a mobile client. All nullable: the deploy migration
  /// scanner treats a NOT NULL addition as risky, and a null token already means
  /// "not registered", so a separate enabled flag would be redundant.
  pushToken        String?  @db.VarChar(200)
  pushPlatform     String?  @db.VarChar(20)
  lastPushAt       DateTime?

  @@unique([userId, clientInstanceId])
  @@index([userId, lastSeenAt])
  @@index([lastSeenAt])
}

model DesktopLoginCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId            String
  redirectUri         String
  state               String
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  usedAt              DateTime?
  ipAddress           String
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model UserPasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model UserWebhook {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId   String            @unique
  secretHash String            @unique
  secret     String?
  name       String            @db.VarChar(80)
  enabled    Boolean           @default(true)
  deletedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]

  @@index([userId, createdAt])
  @@index([userId, deletedAt, createdAt])
}

model WebhookDelivery {
  id                String                   @id @default(cuid())
  webhookId         String
  webhook           UserWebhook              @relation(fields: [webhookId], references: [id], onDelete: Restrict)
  userId            String
  webhookPublicId   String
  webhookName       String
  method            String
  path              String
  query             Json
  headers           Json
  bodyKind          String
  bodySize          Int
  bodyPreview       String?
  bodyText          String?
  bodySha256        String?
  bodyBytes         Int?
  bodyContentType   String?
  payloadVersion    Int?
  receivedAt        DateTime                 @default(now())
  onlineClientCount Int
  sentClientCount   Int
  failedClientCount Int
  status            String
  error             String?
  receipts          WebhookDeliveryReceipt[]

  @@index([webhookId, receivedAt])
  @@index([userId, receivedAt])
  @@index([status, receivedAt])
}

model WebhookDeliveryReceipt {
  id               String          @id @default(cuid())
  deliveryId       String
  delivery         WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  clientInstanceId String
  deviceName       String
  platform         String
  appVersion       String
  sentAt           DateTime
  acknowledgedAt   DateTime?
  status           String

  @@unique([deliveryId, clientInstanceId])
  @@index([deliveryId, sentAt])
}

/// Immutable successful browser visits. Private searchIndex is never returned in public DTOs.
model DriveBrowsingHistory {
  id           String   @id @default(cuid())
  viewerId     String
  viewer       User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  visitId      String   @db.Uuid
  title        String   @db.VarChar(255)
  authorHandle String   @db.VarChar(64)
  kind         String   @db.VarChar(16)
  path         String   @db.VarChar(4096)
  searchIndex  String   @db.Text
  cleared      Boolean  @default(false)
  visitedAt    DateTime @default(now())

  @@unique([viewerId, visitId])
  @@index([viewerId, cleared, visitedAt(sort: Desc), id(sort: Desc)])
  @@index([viewerId, cleared, kind, visitedAt(sort: Desc), id(sort: Desc)])
}

model DriveItem {
  id                    String                      @id @default(cuid())
  userId                String
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId              String?
  parent                DriveItem?                  @relation("DriveTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              DriveItem[]                 @relation("DriveTree")
  type                  String                      @db.VarChar(16)
  name                  String                      @db.VarChar(255)
  size                  BigInt                      @default(0)
  mimeType              String?                     @db.VarChar(255)
  storageKey            String?                     @unique
  storageStatus         String                      @db.VarChar(32)
  uploadStatus          String                      @db.VarChar(32)
  storageDeletePending  Boolean                     @default(false)
  lifecycleStatus       String                      @default("active") @db.VarChar(32)
  trashedAt             DateTime?
  trashedBy             String?
  hiddenAt              DateTime?
  hiddenBy              String?
  restoreParentId       String?
  restorePath           String?
  deleteRootId          String?
  objectMissing         Boolean                     @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                    @default(now())
