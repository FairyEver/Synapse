{
  "name": "@synapse/server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter @synapse/shared run build && prisma migrate deploy && prisma generate && APP_PUBLIC_URL=${APP_PUBLIC_URL:-http://localhost:3000} PORT=${SYNAPSE_SERVER_API_PORT:-3001} pnpm run dev:api",
    "dev:api": "pnpm --filter @synapse/shared run build && nest start --watch",
    "build": "pnpm --filter @synapse/shared run build && pnpm build:api",
    "build:api": "nest build",
    "start": "node dist/main.js",
    "test": "pnpm --filter @synapse/shared run build && vitest run",
    "test:problem-feedback:e2e": "node test/problem-feedback-e2e-database-guard.mjs && pnpm --filter @synapse/shared run build && DATABASE_URL=\"$PROBLEM_FEEDBACK_E2E_DATABASE_URL\" prisma migrate deploy && DATABASE_URL=\"$PROBLEM_FEEDBACK_E2E_DATABASE_URL\" vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @synapse/shared run build && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.0",
    "@synapse/shared": "workspace:*",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^1.9.1",
    "jsonc-parser": "^3.3.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.16.3",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.13",
    "unified": "^11.0.5",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/testing": "^11.1.9",
    "@tailwindcss/vite": "4.2.2",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "25.6.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "typescript": "6.0.2",
    "vitest": "^4.1.5"
  }
}
