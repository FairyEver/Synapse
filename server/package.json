{
  "name": "@synapse/server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "prisma migrate deploy && prisma generate && PORT=${SYNAPSE_SERVER_API_PORT:-3001} pnpm run dev:api & pnpm run dev:admin & wait",
    "dev:api": "nest start --watch",
    "dev:admin": "vite --config admin/vite.config.ts --host 0.0.0.0",
    "build": "pnpm build:api && pnpm build:admin",
    "build:api": "nest build",
    "build:admin": "vite build --config admin/vite.config.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:admin": "vitest run --config admin/vitest.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "shadcn": "shadcn"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "helmet": "^8.1.0",
    "lucide-react": "1.8.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "3.5.0",
    "tar": "^7.5.13",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/testing": "^11.1.9",
    "@tailwindcss/vite": "4.2.2",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/tar": "^7.0.87",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^27.3.0",
    "prisma": "^6.19.0",
    "shadcn": "4.2.0",
    "supertest": "^7.1.4",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vitest": "^4.1.5"
  }
}
