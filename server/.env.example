# 数据库配置
# 用于连接 PostgreSQL，并控制本地开发时暴露的数据库端口。
# PostgreSQL 连接地址；真实环境通常包含账号密码，示例文件中必须留空。
DATABASE_URL=
# PostgreSQL 初始化用户；已有数据库 volume 不要随意修改。
POSTGRES_USER=synapse
# PostgreSQL 初始化数据库名；已有数据库 volume 不要随意修改。
POSTGRES_DB=synapse
# PostgreSQL 用户密码；仅供本地数据库容器或部署环境使用。
POSTGRES_PASSWORD=
# PostgreSQL 映射到宿主机的端口。
POSTGRES_HOST_PORT=5433
# 后端数据库连接池大小。
DATABASE_POOL_SIZE=10

# 服务配置
# 用于控制 server 监听端口和对外访问地址。
# server HTTP 服务监听端口。
PORT=3000
# 应用对外访问地址，用于生成回调、跳转或公开链接；复制后必须替换为当前部署的站点根地址，不带 /api。
APP_PUBLIC_URL=https://yourdomain.com
# 反向代理信任配置；留空或 false 时不信任 X-Forwarded-*，部署在可信代理后可填代理跳数或子网。
TRUST_PROXY=false

# 管理员与用户鉴权
# 用于初始化管理员账号，以及签发后台和用户访问令牌。
# 初始化管理员邮箱。
ADMIN_EMAIL=admin@synapse.com
# 初始化管理员密码；示例文件中必须留空。
ADMIN_PASSWORD=
# 后台管理员 JWT 签名密钥；示例文件中必须留空。
ADMIN_JWT_SECRET=
# 用户访问令牌 JWT 签名密钥；示例文件中必须留空。
USER_ACCESS_JWT_SECRET=
# 用户访问令牌有效期，单位分钟。
USER_ACCESS_TOKEN_MINUTES=15
# 用户刷新令牌有效期，单位天。
USER_REFRESH_TOKEN_DAYS=30

# 许可证配置
# 用于生成、校验和租约管理授权许可证。
# 许可证签名私钥；示例文件中必须留空。
LICENSE_PRIVATE_KEY=
# 许可证验签公钥；如果包含真实部署密钥，示例文件中必须留空。
LICENSE_PUBLIC_KEY=
# 许可证密钥标识，用于区分当前签名密钥版本。
LICENSE_KEY_ID=local-dev-key
# 许可证租约有效期，单位天。
LICENSE_LEASE_DAYS=7

# 激活风控配置
# 用于控制激活失败留存、频率限制和异常绑定检测阈值。
# 激活尝试记录保留天数。
ACTIVATION_ATTEMPT_RETENTION_DAYS=90
# 激活失败频率限制统计窗口，单位分钟。
ACTIVATION_RATE_WINDOW_MINUTES=15
# 同一 IP 在统计窗口内允许的最大失败次数。
ACTIVATION_RATE_MAX_FAILURES_PER_IP=20
# 同一邮箱在统计窗口内允许的最大失败次数。
ACTIVATION_RATE_MAX_FAILURES_PER_EMAIL=8
# 同一设备在统计窗口内允许的最大失败次数。
ACTIVATION_RATE_MAX_FAILURES_PER_DEVICE=8
# 激活风险检测统计窗口，单位分钟。
ACTIVATION_RISK_WINDOW_MINUTES=60
# 同一激活码在风险窗口内允许绑定的最大不同 IP 数。
ACTIVATION_RISK_MAX_DISTINCT_IPS_PER_CODE=6
# 同一激活码在风险窗口内允许绑定的最大不同邮箱数。
ACTIVATION_RISK_MAX_DISTINCT_EMAILS_PER_CODE=4
# 同一激活码在风险窗口内允许绑定的最大不同设备数。
ACTIVATION_RISK_MAX_DISTINCT_DEVICES_PER_CODE=4
# 同一激活码在风险窗口内允许的最大绑定冲突次数。
ACTIVATION_RISK_MAX_BOUND_CONFLICTS_PER_CODE=3

# 用户云盘 COS 配置
# 用于存储 Drive 用户云盘文件。
# 腾讯云 COS SecretId；示例文件中必须留空。
DRIVE_COS_SECRET_ID=
# 腾讯云 COS SecretKey；示例文件中必须留空。
DRIVE_COS_SECRET_KEY=
# Drive 用户云盘文件所在 COS 存储桶。
DRIVE_COS_BUCKET=synapse-file-user-1252371654
# Drive 用户云盘文件所在 COS 地域。
DRIVE_COS_REGION=ap-beijing
# Drive 未配置 COS 时的本地持久化存储根目录；生产环境未配置 COS 时必须设置，并挂载到持久磁盘。
SYNAPSE_DRIVE_LOCAL_ROOT=/app/data/drive

# Skill Repository COS 配置
# 用于存储云端 Skill 仓库文件和安装包。
# 腾讯云 COS SecretId；示例文件中必须留空。
SKILL_REPOSITORY_COS_SECRET_ID=
# 腾讯云 COS SecretKey；示例文件中必须留空。
SKILL_REPOSITORY_COS_SECRET_KEY=
# Skill Repository 文件所在 COS 存储桶。
SKILL_REPOSITORY_COS_BUCKET=synapse-skill-repository-1252371654
# Skill Repository 文件所在 COS 地域。
SKILL_REPOSITORY_COS_REGION=ap-beijing

# 平台媒体 COS 配置
# 用于存储用户头像、智能体头像等平台承担的小型公共媒体资源；Bucket 建议保持私有读写。
# 腾讯云 COS SecretId；示例文件中必须留空。
PLATFORM_MEDIA_COS_SECRET_ID=
# 腾讯云 COS SecretKey；示例文件中必须留空。
PLATFORM_MEDIA_COS_SECRET_KEY=
# 平台媒体资源所在 COS 存储桶。
PLATFORM_MEDIA_COS_BUCKET=synapse-file-platform-1252371654
# 平台媒体资源所在 COS 地域。
PLATFORM_MEDIA_COS_REGION=ap-beijing

# 备份 COS 配置
# 用于存储后台备份文件。
# 腾讯云 COS SecretId；示例文件中必须留空。
BACKUP_COS_SECRET_ID=
# 腾讯云 COS SecretKey；示例文件中必须留空。
BACKUP_COS_SECRET_KEY=
# 后台备份文件所在 COS 存储桶。
BACKUP_COS_BUCKET=synapse-file-backup-1252371654
# 后台备份文件所在 COS 地域。
BACKUP_COS_REGION=ap-beijing
