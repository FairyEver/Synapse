{
  "name": "@synapse/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @synapse/shared run build && vite",
    "build": "pnpm --filter @synapse/shared build && pnpm check:ui && tsc --noEmit && vite build",
    "preview": "vite preview --port 19700 --strictPort",
    "tsc": "tsc --noEmit",
    "docs:heroui:sync": "node scripts/sync-heroui-docs.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check:ui": "node scripts/check-ui-boundaries.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "react": "^19.2.5",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-avatar-editor": "^15.1.0",
    "react-dom": "^19.2.5",
    "tailwindcss": "4.2.2",
    "@fontsource-variable/inter": "5.2.8",
    "@mdxeditor/editor": "4.0.4",
    "@monaco-editor/react": "4.7.0",
    "@synapse/shared": "workspace:*",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-router": "1.170.9",
    "@tanstack/react-table": "8.21.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "github-markdown-css": "5.9.0",
    "lib0": "0.2.117",
    "lucide-react": "1.8.0",
    "mermaid": "11.15.0",
    "monaco-editor": "0.55.1",
    "react-hook-form": "7.76.1",
    "react-resizable-panels": "4.10.0",
    "recharts": "3.8.1",
    "tailwind-merge": "3.5.0",
    "y-indexeddb": "9.0.12",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31",
    "zod": "4.4.3",
    "zustand": "5.0.14",
    "@hookform/resolvers": "5.4.0"
