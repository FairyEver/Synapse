    "vite": "^8.0.8",
    "@tanstack/router-plugin": "1.168.12",
    "vitest": "4.1.5",
    "@vitest/browser-playwright": "4.1.5",
    "playwright": "1.59.1",
    "vitest-browser-react": "2.2.0",
    "jsdom": "27.4.0"
  },
  "engines": {
    "node": ">=22.22.0"
