{
  "name": "@synapse/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Synapse admin dashboard",
  "scripts": {
    "dev": "pnpm --filter @synapse/shared run build && vite --port 3000 --host 0.0.0.0 --open /console/",
