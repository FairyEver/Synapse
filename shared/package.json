{
  "name": "@synapse/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drive-search": {
      "import": {
        "types": "./dist/drive-search.d.ts",
        "default": "./dist/drive-search.js"
      },
      "require": {
        "types": "./dist/drive-search.d.cts",
        "default": "./dist/drive-search.cjs"
      },
      "default": "./dist/drive-search.js"
    },
    "./drive-sync-constants": {
      "import": {
        "types": "./dist/drive-sync-constants.d.ts",
        "default": "./dist/drive-sync-constants.js"
      },
      "require": {
        "types": "./dist/drive-sync-constants.d.cts",
        "default": "./dist/drive-sync-constants.cjs"
      },
      "default": "./dist/drive-sync-constants.js"
    },
    "./versioned-data-migrator": {
      "import": {
        "types": "./dist/versioned-data-migrator.d.ts",
        "default": "./dist/versioned-data-migrator.js"
      },
      "require": {
        "types": "./dist/versioned-data-migrator.d.cts",
        "default": "./dist/versioned-data-migrator.cjs"
      },
      "default": "./dist/versioned-data-migrator.js"
    },
    "./mobile-live-constants": {
      "types": "./dist/mobile-live-constants.d.cts",
      "import": "./dist/mobile-live-constants.cjs",
      "require": "./dist/mobile-live-constants.cjs",
      "default": "./dist/mobile-live-constants.cjs"
    },
    "./notification-constants": {
      "import": {
        "types": "./dist/notifications.d.ts",
        "default": "./dist/notifications.js"
      },
      "require": {
        "types": "./dist/notification-constants.d.cts",
        "default": "./dist/notification-constants.cjs"
      },
      "default": "./dist/notifications.js"
    },
    "./todo-contracts": {
      "import": {
        "types": "./dist/todos.d.ts",
        "default": "./dist/todos.js"
      },
      "require": {
        "types": "./dist/todo-contracts.d.cts",
        "default": "./dist/todo-contracts.cjs"
      },
      "default": "./dist/todos.js"
    },
    "./cloud-table-contracts": {
      "import": {
        "types": "./dist/cloud-table-contracts.d.ts",
        "default": "./dist/cloud-table-contracts.js"
      },
      "require": {
        "types": "./dist/cloud-table-contracts.d.cts",
        "default": "./dist/cloud-table-contracts.cjs"
      },
      "default": "./dist/cloud-table-contracts.js"
    },
    "./skill-hub-contracts": {
      "import": {
        "types": "./dist/skill-hub-contracts.d.ts",
        "default": "./dist/skill-hub-contracts.js"
      },
      "require": {
        "types": "./dist/skill-hub-contracts.d.cts",
        "default": "./dist/skill-hub-contracts.cjs"
      },
      "default": "./dist/skill-hub-contracts.js"
    },
    "./skill-hub-package-node": {
      "import": {
        "types": "./dist/skill-hub-package-node.d.ts",
        "default": "./dist/skill-hub-package-node.js"
      },
      "require": {
        "types": "./dist/skill-hub-package-node.d.cts",
        "default": "./dist/skill-hub-package-node.cjs"
      },
      "default": "./dist/skill-hub-package-node.js"
    },
    "./archive-package-node": {
      "import": {
        "types": "./dist/archive-package-node.d.ts",
        "default": "./dist/archive-package-node.js"
      },
      "require": {
        "types": "./dist/archive-package-node.d.cts",
        "default": "./dist/archive-package-node.cjs"
      },
      "default": "./dist/archive-package-node.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-mobile-workspace-files-constants.mjs && tsc -p tsconfig.json && node scripts/build-notification-constants.mjs && node scripts/build-todo-contracts.mjs && node scripts/build-drive-sync-constants.mjs && node scripts/build-drive-search.mjs && node scripts/build-versioned-data-migrator.mjs && node scripts/build-dual-contracts.mjs",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
