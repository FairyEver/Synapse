<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Synapse</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  The app speaks only HTTPS/TLS, which is exempt from the export-control
	  question. Declaring it here is what keeps App Store Connect from asking it
	  again on every single upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  The terminal grid font. iOS ships nothing that covers the private use area a
	  shell prompt draws its branch and language markers from, so the family is
	  bundled; without it those characters render as replacement boxes.

	  These are bare file names on purpose: the target uses a synchronised folder
	  group, which flattens resources into the bundle root rather than preserving
	  `Fonts/`. A path with a directory in it would not resolve, and the failure is
	  silent — the terminal would just fall back to the system monospace face.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>MapleMono-NF-CN-Regular.ttf</string>
		<string>MapleMono-NF-CN-Bold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<!--
	  The deployment target is 18.0, so the binary carries an arm64 slice and
	  nothing else. Naming armv7 here was left over from the Xcode template and
	  describes a slice the app does not have.
	-->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Terminal alerts are worth waking a suspended app for. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  Narrow transport exception, not a blanket one: it permits cleartext only to
	  hosts on the local network, which is what the simulator and a LAN development
	  server need. Everything remote still requires TLS.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
