<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Synapse</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  The app speaks only HTTPS/TLS, which is exempt from the export-control
	  question. Declaring it here is what keeps App Store Connect from asking it
	  again on every single upload.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  The terminal grid font. iOS ships nothing that covers the private use area a
	  shell prompt draws its branch and language markers from, so the family is
	  bundled; without it those characters render as replacement boxes.

	  These are bare file names on purpose: the target uses a synchronised folder
	  group, which flattens resources into the bundle root rather than preserving
	  `Fonts/`. A path with a directory in it would not resolve, and the failure is
	  silent — the terminal would just fall back to the system monospace face.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>MapleMono-NF-CN-Regular.ttf</string>
		<string>MapleMono-NF-CN-Bold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<!--
	  The deployment target is 18.0, so the binary carries an arm64 slice and
	  nothing else. Naming armv7 here was left over from the Xcode template and
	  describes a slice the app does not have.
	-->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
	  `audio`, and only because recording continues in the background. A meeting is
	  held with the phone in a pocket, and iOS suspends an app that does not claim
	  this — the recording would simply stop, with nothing to show for it.

	  This used to be absent on purpose, on the argument that claiming a background
	  mode nothing exercises is something App Review asks about. That argument still
	  holds for silent push, which this app really does not do: the server sends
	  every alert as `apns-push-type: alert`, and the app delegate has no
	  `didReceiveRemoteNotification:fetchCompletionHandler:`. It just no longer
	  describes what the app does.

	  Narrow transport exception, not a blanket one: it permits cleartext only to
	  hosts on the local network, which is what the simulator and a LAN development
	  server need. Everything remote still requires TLS.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!--
	  Live Activities and Control Centre controls are rendered by a WidgetKit
	  extension, but the *permission* to show them belongs to the app that starts
	  them. Without this key `Activity.request` fails, and the failure is silent.
	-->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!--
	  The only picker source that runs in this app's own process. Photos and Files
	  are chosen inside system extensions and need no usage description of their
	  own, so the camera is the reason this particular key exists.
	-->
	<key>NSCameraUsageDescription</key>
	<string>拍照片或录像发给电脑上的终端。</string>
	<!--
	  Read for exactly one thing: the newest picture, offered above the input bar as
	  a one-tap send. Every other way a photo reaches this app goes through
	  `PHPickerViewController`, which runs out of process and shows the library
	  without the app gaining access to it — but a picker only answers once someone
	  has picked, so "the one just taken" cannot be asked of it.

	  It is not asked for at launch. The prompt appears the first time the user has
	  actually used the photo picker once; before that nothing here reads the library,
	  and a denial costs nothing but the offer.
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>把刚拍的照片、刚截的图摆在输入栏上方，点一下发到电脑上的终端。</string>
	<!--
	  The microphone, for three things now: turning speech into text in the terminal
	  input bar, the sound on a video, and recording. The last one is why this
	  sentence changed — this prompt is where a user meets recording for the first
	  time, and it used to describe everything except that.

	  The transcription happens in the cloud rather than on device, so the app never
	  touches the system's speech recogniser and has no reason to ask for it.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>用于录音，以及把说的话转成文字填进终端输入框、录像时收录声音。</string>
</dict>
</plist>
