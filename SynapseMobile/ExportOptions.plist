<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Archive → App Store Connect, used by scripts/release-ios.sh.

  The release script changes `destination` to `export` for both workflows.
  For TestFlight it uploads the signed IPA separately with Apple's altool,
  avoiding Xcode's unreliable upload-account lookup.

  Signing is left automatic on purpose: `signingStyle` is absent, so xcodebuild
  resolves the distribution certificate and profile itself. The credential it
  resolves them with is the App Store Connect API key that
  scripts/release-ios.sh passes on the command line, not the Apple ID signed
  into Xcode, which fails intermittently with "Failed to Use Accounts".
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>U4JT7UKH9W</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>upload</string>
	<!-- The app links no third-party frameworks with bitcode-era requirements,
	     and none of its own dependencies are managed by a package manager that
	     needs a manifest uploaded alongside. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
