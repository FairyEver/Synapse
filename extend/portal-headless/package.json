{
  "name": "@synapse/portal-headless",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Portal 服务端无头 SDK：按页面能力驱动 Portal，供 AI 调用",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ai:check": "pnpm build && node tools/ai-contract/check.mjs",
    "ai:check:complete": "pnpm build && node tools/ai-contract/check.mjs --complete",
    "build": "node tools/build.mjs",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "generate": "node tools/generate/generate.mjs",
    "smoke:meeting-room": "node smoke/read-meeting-rooms.mjs",
    "smoke:prepare": "node smoke/prepare-meeting-application.mjs",
    "smoke:submit": "node smoke/submit-meeting-application.mjs",
    "openapi": "node tools/generate/openapi.mjs",
    "report": "node tools/generate/report.mjs",
    "docs": "pnpm build && pnpm generate && node tools/generate/derive-aliases.mjs && pnpm build && pnpm openapi && pnpm docs:lint && pnpm docs:html && pnpm report && pnpm scope:audit",
    "docs:lint": "redocly lint generated/openapi.json",
    "docs:html": "redocly build-docs generated/openapi.json -o generated/api-docs.html",
    "docs:drift": "node tools/generate/drift-check.mjs",
    "report:watch": "node tools/generate/watch.mjs",
    "next": "node tools/generate/next.mjs",
    "docs:check": "pnpm docs:drift",
    "coverage:pc": "pnpm build && node tools/generate/pc-coverage.mjs",
    "coverage:pc:check": "pnpm build && node tools/generate/pc-coverage.mjs --check",
    "scope:audit": "node tools/generate/scope-audit.mjs",
    "scope:audit:check": "node tools/generate/scope-audit.mjs --check"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.3",
    "@types/node": "25.6.0",
    "@types/qs": "^6.15.1",
    "typescript": "6.0.2",
    "vitest": "^4.1.5"
  }
}
