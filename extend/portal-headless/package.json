{
  "name": "@synapse/portal-headless",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Portal 服务端无头 SDK：按页面能力驱动 Portal，供 AI 调用",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node tools/build.mjs",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "generate": "node tools/generate/generate.mjs",
    "aliases:derive": "node tools/generate/derive-aliases.mjs",
    "next": "node tools/generate/next.mjs",
    "ai:check": "pnpm build && node tools/ai-contract/check.mjs",
    "ai:check:complete": "pnpm build && node tools/ai-contract/check.mjs --complete",
    "smoke:meeting-room": "node smoke/read-meeting-rooms.mjs",
    "smoke:prepare": "node smoke/prepare-meeting-application.mjs",
    "smoke:submit": "node smoke/submit-meeting-application.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/qs": "^6.15.1",
    "typescript": "6.0.2",
    "vitest": "^4.1.5"
  }
}
