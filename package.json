{
  "name": "synapse",
  "productName": "Synapse",
  "private": true,
  "version": "0.1.1",
  "description": "Synapse desktop scaffold built with Electron, Vite, React, Tailwind CSS, and shadcn/ui.",
  "author": "FairyEver",
  "homepage": "https://github.com/FairyEver/Synapse",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "node scripts/dev-renderer.mjs",
    "dev:electron:build": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:app": "node scripts/dev-electron-app.mjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "pnpm exec electron-builder --publish never",
    "package:mac": "pnpm exec electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "pnpm exec electron-builder --win nsis --x64 --publish never",
    "release": "pnpm exec electron-builder --publish always",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairyEver/Synapse.git"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "41.2.1",
    "electron-builder": "26.3.3",
    "nodemon": "3.1.14",
    "shadcn": "4.2.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "wait-on": "9.0.5"
  },
  "build": {
    "appId": "com.fairyever.synapse",
    "productName": "Synapse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FairyEver",
        "repo": "Synapse",
        "releaseType": "release",
        "tagNamePrefix": "v"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
