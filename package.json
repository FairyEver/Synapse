{
  "name": "synapse",
  "productName": "Synapse",
  "private": true,
  "version": "0.1.83",
  "description": "Synapse desktop scaffold built with Electron, Vite, React, Tailwind CSS, and shadcn/ui.",
  "author": "FairyEver",
  "homepage": "https://github.com/FairyEver/Synapse",
  "main": "dist-electron/electron/main.js",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "node scripts/dev-renderer.mjs",
    "dev:electron:build": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:app": "node scripts/dev-electron-app.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build": "pnpm build:renderer && pnpm build:electron && pnpm build:data-store",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:data-store": "esbuild data-store/cli/index.ts --bundle --platform=node --target=node18 --outfile=dist-data-store/cli/index.js --format=cjs && esbuild data-store/mcp/index.ts --bundle --platform=node --target=node18 --outfile=dist-data-store/mcp/index.js --format=cjs",
    "package": "pnpm exec electron-builder --publish never",
    "package:mac": "pnpm exec electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "pnpm exec electron-builder --win nsis --x64 --publish never",
    "bump:commit:push": "sh scripts/bump-version-commit-push.sh",
    "release": "pnpm exec electron-builder --publish always",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairyEver/Synapse.git"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "6.8.3",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.3.0",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "lucide-react": "1.8.0",
    "markdown-it": "^14.1.1",
    "markdown-it-container": "^4.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-avatar-editor": "^15.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "react-resizable-panels": "^4.10.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-avatar-editor": "^13.0.4",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "41.2.1",
    "electron-builder": "26.3.3",
    "esbuild": "^0.28.0",
    "nodemon": "3.1.14",
    "shadcn": "4.2.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "wait-on": "9.0.5"
  },
  "build": {
    "appId": "com.fairyever.synapse",
    "productName": "Synapse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "source/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates"
      },
      {
        "from": "dist-data-store",
        "to": "data-store"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "FairyEver",
        "repo": "Synapse",
        "releaseType": "release",
        "tagNamePrefix": "v"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
