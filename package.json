{
  "name": "synapse-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "kill": "ps aux | grep -E 'scripts/dev\\.mjs|dev:renderer|dev:electron|dev-electron-app|vite\\.js.*(5173|strictPort)|vitepress.*dev|concurrently.*renderer.*electron|nodemon.*electron|Synapse.*Electron|electron \\.' | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null; echo 'Done.'",
    "desktop:dev": "pnpm --filter @synapse/desktop run dev",
    "desktop:dev:renderer": "pnpm --filter @synapse/desktop run dev:renderer",
    "desktop:dev:electron:build": "pnpm --filter @synapse/desktop run dev:electron:build",
    "desktop:dev:electron:app": "pnpm --filter @synapse/desktop run dev:electron:app",
    "desktop:icons": "pnpm --filter @synapse/desktop run icons",
    "desktop:build": "pnpm --filter @synapse/desktop run build",
    "desktop:build:renderer": "pnpm --filter @synapse/desktop run build:renderer",
    "desktop:build:electron": "pnpm --filter @synapse/desktop run build:electron",
    "desktop:build:data-store": "pnpm --filter @synapse/desktop run build:data-store",
    "desktop:package:mac": "pnpm --filter @synapse/desktop run package:mac",
    "desktop:package:win": "pnpm --filter @synapse/desktop run package:win",
    "desktop:bump:commit:push": "pnpm --filter @synapse/desktop run bump:commit:push",
    "desktop:typecheck": "pnpm --filter @synapse/desktop run typecheck",
    "website:dev": "pnpm --filter @synapse/website run dev",
    "website:build": "pnpm --filter @synapse/website run build",
    "website:preview": "pnpm --filter @synapse/website run preview"
  }
}
