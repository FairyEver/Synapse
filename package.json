{
  "name": "synapse",
  "private": true,
  "version": "0.1.0",
  "description": "Synapse desktop scaffold built with Electron, Vite, React, Tailwind CSS, and shadcn/ui.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k --names renderer,electron:build,electron:app --prefix-colors cyan,magenta,yellow \"pnpm dev:renderer\" \"pnpm dev:electron:build\" \"pnpm dev:electron:app\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron:build": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:app": "wait-on tcp:127.0.0.1:5173 file:dist-electron/main.js file:dist-electron/preload.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 nodemon",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "41.2.1",
    "nodemon": "3.1.14",
    "shadcn": "4.2.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "wait-on": "9.0.5"
  }
}
