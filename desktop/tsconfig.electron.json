{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": "dist-electron",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "action-packages/**/*.ts", "app-capabilities/text-extractor/main/worker.ts", "database/shared/**/*.ts", "synapse-capabilities/shared/**/*.ts"],
  "exclude": ["electron/preload.ts", "**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
