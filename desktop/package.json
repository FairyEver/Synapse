{
  "name": "@synapse/desktop",
  "productName": "Synapse",
  "private": true,
  "version": "0.2.365",
  "description": "Synapse desktop scaffold built with Electron, Vite, React, Tailwind CSS, and shadcn/ui.",
  "author": "FairyEver",
  "homepage": "https://github.com/FairyEver/Synapse",
  "main": "dist-electron/electron/main.js",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && node scripts/build/generate-definitions-registry.mjs && node scripts/dev/dev.mjs",
    "dev:renderer": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && node scripts/build/generate-definitions-registry.mjs && node scripts/dev/dev-renderer.mjs",
    "dev:electron:build": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && node scripts/build/generate-definitions-registry.mjs && node scripts/build/generate-ipc.mjs && concurrently --kill-others-on-fail \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"pnpm build:preload --watch\"",
    "dev:electron:app": "node scripts/dev/dev-electron-app.mjs",
    "icons": "node scripts/build/build-icons.mjs",
    "build": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && pnpm generate:definitions-registry && pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && node scripts/build/generate-ipc.mjs && tsc -p tsconfig.electron.json && pnpm build:preload",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --target=es2022 --format=cjs --external:electron --outfile=dist-electron/electron/preload.js --sourcemap",
    "generate:deployment-config": "node scripts/build/generate-deployment-config.mjs",
    "generate:definitions-registry": "node scripts/build/generate-definitions-registry.mjs",
    "generate:ipc": "node scripts/build/generate-ipc.mjs",
    "check:ipc-codegen": "node scripts/checks/check-ipc-codegen.mjs",
    "check:hard-constraints": "node scripts/checks/check-hard-constraints.mjs",
    "check:packaged-asar": "node scripts/checks/verify-packaged-asar.mjs release",
    "check:script-runtime": "pnpm check:script-runtime:runtime-smoke",
    "check:script-runtime:runtime-smoke": "pnpm build:electron && electron scripts/checks/script-runtime-app",
    "check:script-runtime:runtime-smoke:built": "electron scripts/checks/script-runtime-app",
    "check:script-runtime:packaged": "node scripts/checks/verify-packaged-script-runtime.mjs release",
    "check:script-runtime:surface": "vitest run app-capabilities/__tests__/script-capability-packages.test.ts workflow-nodes/__tests__/registry.test.ts src/action-runtime/__tests__/action-registry.test.tsx",
    "check:terminal-runtime": "electron scripts/checks/terminal-runtime-app",
    "database:import-legacy": "node --no-warnings scripts/migrations/import-legacy-database.mjs",
    "package:mac": "pnpm build && pnpm package:mac:compiled",
    "package:mac:compiled": "pnpm exec electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "pnpm build && pnpm package:win:compiled",
    "package:win:compiled": "pnpm exec electron-builder --win nsis --x64 --publish never",
    "release:mac": "node scripts/release/package-mac-release.mjs --check && pnpm bump:commit:push && node scripts/release/package-mac-release.mjs && node scripts/release/publish-mac-release.mjs",
    "bump:commit:push": "node scripts/release/bump-version-commit-push.mjs",
    "typecheck": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && pnpm generate:definitions-registry && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && vitest run",
    "test:watch": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && vitest",
    "test:ipc": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && vitest run tests/ipc",
    "test:ci": "pnpm --filter @synapse/shared run build && pnpm generate:deployment-config && vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairyEver/Synapse.git"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dagrejs/dagre": "^1.1.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@synapse/shared": "workspace:*",
    "@uiw/react-codemirror": "^4.25.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docxtemplater": "^3.69.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "ejs": "6.0.1",
    "electron-updater": "6.8.3",
    "fuse.js": "^7.3.0",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "lucide-react": "1.8.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "markdown-it-container": "^4.0.0",
    "node-pty": "^1.1.0",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-avatar-editor": "^15.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "react-resizable-panels": "^4.10.0",
    "repair-json-stream": "1.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "3.5.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "vaul": "^1.1.2",
    "ws": "^8.20.0",
    "yaml": "^2.8.4",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "2": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/dagre": "^0.7.52",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-avatar-editor": "^13.0.4",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "41.2.1",
    "electron-builder": "26.3.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "jsdom": "^27.4.0",
    "nodemon": "3.1.14",
    "shadcn": "4.2.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.59.0",
    "vite": "8.0.8",
    "vitest": "^4.1.5",
    "wait-on": "9.0.5"
  },
  "build": {
    "appId": "com.fairyever.synapse",
    "productName": "Synapse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/@synapse/shared/**/*",
      "build/icon.ico",
      "source/icon.png",
      "source/tray/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/claude",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/claude.exe",
      "node_modules/unpdf/**",
      "node_modules/mammoth/**",
      "node_modules/pizzip/**",
      "node_modules/@xmldom/xmldom/**",
      "node_modules/argparse/**",
      "node_modules/sprintf-js/**",
      "node_modules/base64-js/**",
      "node_modules/bluebird/**",
      "node_modules/dingbat-to-unicode/**",
      "node_modules/jszip/**",
      "node_modules/lie/**",
      "node_modules/immediate/**",
      "node_modules/pako/**",
      "node_modules/readable-stream/**",
      "node_modules/core-util-is/**",
      "node_modules/inherits/**",
      "node_modules/isarray/**",
      "node_modules/process-nextick-args/**",
      "node_modules/safe-buffer/**",
      "node_modules/string_decoder/**",
      "node_modules/util-deprecate/**",
      "node_modules/setimmediate/**",
      "node_modules/lop/**",
      "node_modules/duck/**",
      "node_modules/underscore/**",
      "node_modules/option/**",
      "node_modules/path-is-absolute/**",
      "node_modules/xmlbuilder/**",
      "dist-electron/action-packages/shared/**",
      "dist-electron/app-capabilities/html-generator/**",
      "dist-electron/app-capabilities/text-extractor/**",
      "node_modules/ejs/**",
      "dist-electron/electron/services/usage-analysis/**",
      "dist-electron/electron/services/model-price/**",
      "dist-electron/src/**"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "extraResources": [
      {
        "from": "app-capabilities/synapse-skill/skill-package",
        "to": "synapse-skill"
      },
      {
        "from": "resources/knowledge-base",
        "to": "knowledge-base"
      }
    ],
    "protocols": [
      {
        "name": "Synapse",
        "schemes": [
          "synapse"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://desktop.release.synapse.d2.pub/",
        "channel": "latest",
        "useMultipleRangeRequest": false
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extraFiles": [
        {
          "from": "node_modules/node-pty/build/Release/spawn-helper",
          "to": "Frameworks/node-pty-spawn-helper"
        }
      ],
      "hardenedRuntime": true,
      "notarize": true,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Synapse 需要访问文稿文件夹以管理你的内容仓库。",
        "NSDesktopFolderUsageDescription": "Synapse 需要访问桌面文件夹以管理你的内容仓库。",
        "NSDownloadsFolderUsageDescription": "Synapse 需要访问下载文件夹以导出内容和备份。"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
